  "suiteRevision": "verification/v1",
  "id": "G03",
  "objective": "Recover an already persisted effect while preserving an uncertain provider result, without repeated dispatch after either lost confirmation.",
  "criteria": [
    {
      "id": "G03.persisted-effect-recovered",
      "description": "Reopening recovers a persisted operation without creating another row.",
      "profile": "offline",
      "required": true,
      "checks": [
        {
          "kind": "equals",
          "artifact": "observations",
          "path": "/http/persistedReplyLost/status",
          "expected": 502
        },
        {
          "kind": "length",
          "artifact": "observations",
          "path": "/db/persistedBeforeReopen",
          "expected": 1
        },
        {
          "kind": "same",
          "artifact": "observations",
          "path": "/db/persistedBeforeReopen",
          "otherPath": "/db/persistedAfterReopen"
        },
        {
          "kind": "same",
          "artifact": "observations",
          "path": "/controller/persistedReopened/operationId",
          "otherPath": "/db/persistedAfterReopen/0/id"
        },
        {
          "kind": "equals",
          "artifact": "observations",
          "path": "/controller/persistedReopened/status",
          "expected": "completed"
        },
        {
          "kind": "equals",
          "artifact": "observations",
          "path": "/http/persistedReopen/status",
          "expected": 200
        },
        {
          "kind": "equals",
          "artifact": "observations",
          "path": "/http/persistedReplay/status",
          "expected": 200
        },
        {
          "kind": "equals",
          "artifact": "observations",
          "path": "/http/persistedReplay/body/status",
          "expected": "completed"
        }
      ]
    },
    {
      "id": "G03.provider-result-unknown",
      "description": "A lost provider response remains unknown to the product after reopening.",
      "profile": "offline",
      "required": true,
      "checks": [
        {
          "kind": "equals",
          "artifact": "observations",
          "path": "/http/providerReplyLost/status",
          "expected": 502
        },
        {
          "kind": "equals",
          "artifact": "observations",
          "path": "/controller/providerLostAfterReopen/status",
          "expected": "unknown"
        },
        {
          "kind": "length",
          "artifact": "observations",
          "path": "/providerLedger/unknownBeforeReopen",
          "expected": 1
        },
        {
          "kind": "equals",
          "artifact": "observations",
          "path": "/http/unknownReopen/status",
          "expected": 200
        },
        {
          "kind": "length",
          "artifact": "observations",
          "path": "/db/unknownBeforeReopen",
          "expected": 1
        },
        {
          "kind": "equals",
          "artifact": "observations",
          "path": "/db/unknownBeforeReopen/0/state",
          "expected": "unknown"
        },
        {
          "kind": "same",
          "artifact": "observations",
          "path": "/db/unknownBeforeReopen",
          "otherPath": "/db/unknownAfterReopen"
        },
        {
          "kind": "length",
          "artifact": "observations",
          "path": "/db/unknownAssets",
          "expected": 0
        }
      ]
    },
    {
      "id": "G03.no-repeat-after-unknown",
      "description": "Reopening and advancing time do not repeat either dispatched effect.",
      "profile": "offline",
      "required": true,
      "checks": [
        {
          "kind": "length",
          "artifact": "observations",
          "path": "/providerLedger/persistedBeforeReopen",
          "expected": 1
        },
        {
          "kind": "same",
          "artifact": "observations",
          "path": "/providerLedger/persistedBeforeReopen",
          "otherPath": "/providerLedger/persistedAfterReopen"
        },
        {
          "kind": "same",
          "artifact": "observations",
          "path": "/providerLedger/unknownBeforeReopen",
          "otherPath": "/providerLedger/unknownAfterReopen"
        },
        {
          "kind": "equals",
          "artifact": "observations",
          "path": "/http/unknownReplay/status",
          "expected": 409
        },
        {
          "kind": "equals",
          "artifact": "observations",
          "path": "/http/unknownReplay/body/status",
          "expected": "unknown"
        },
        {
          "kind": "equals",
          "artifact": "observations",
          "path": "/http/unknownNewRequest/status",
          "expected": 409
        },
        {
          "kind": "equals",
          "artifact": "observations",
          "path": "/http/unknownNewRequest/body/status",
          "expected": "blocked"
        }
      ]
    }
  ]
}
