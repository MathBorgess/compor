{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "compor-site",
  // Static assets only — no Worker script. See Cloudflare's Astro guide:
  // https://developers.cloudflare.com/workers/framework-guides/web-apps/astro/
  "compatibility_date": "2026-10-31",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "compor.mathai.com.br",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  }
}
