{
  "name": "compor-quality",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.1"
  },
  "scripts": {
    "quality:lint": "eslint apps/web/app apps/web/lib packages/*/src scripts/quality --max-warnings=0",
    "quality:maintenance": "node scripts/quality/maintainability.mjs",
    "quality:unit": "node scripts/quality/test-packages.mjs",
    "quality:browser": "node scripts/quality/test-browser.mjs",
    "quality:build": "npm --prefix apps/web run build",
    "quality:performance": "node scripts/quality/performance.mjs",
    "quality:test": "node --test --test-timeout=60000 scripts/quality/*.test.mjs",
    "quality:typecheck": "npm --prefix apps/web run typecheck"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@eslint/js": "10.0.1",
    "chrome-launcher": "1.2.2",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "lighthouse": "13.6.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  },
  "overrides": {
    "minimatch": "11.0.4"
  }
}
