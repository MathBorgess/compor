        "compor-curated/color-contrast-direction"
      ],
      "access_method": "curated_board_http",
      "license_default": "inspiration_only",
      "cost_tier": "free_http",
      "rate_limit": {
        "requests_per_minute": 30,
        "timeout_ms": 5000
      },
      "active": true
    },
    {
